# Tessera local-development environment.
#
# Copy this file to .env.local (which is gitignored) and fill in the values
# you need. Variables follow the TESSERA_* prefix and use a double-underscore
# delimiter for nested settings (e.g. TESSERA_VERTEX__PROJECT_ID).

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------
TESSERA_ENVIRONMENT=local          # local | ci | staging | production
TESSERA_LLM_PROFILE=auto           # auto | frontier | on_prem
TESSERA_DEFAULT_LANGUAGE=fr

# ----------------------------------------------------------------------------
# Environment isolation — docker compose (ADR 0014, layer 2)
# ----------------------------------------------------------------------------
# These drive docker-compose.yml variable substitution (NOT app settings), so
# two environments can `docker compose up` simultaneously without colliding:
# each env becomes its own compose project (own network + volumes), with its own
# container names, host ports, and Postgres. Defaults reproduce the historical
# `local` stack. Use a per-env file, e.g.:  docker compose --env-file .env.staging up
TESSERA_ENV=local                  # compose project + agent TESSERA_ENVIRONMENT
TESSERA_PG_PORT=5432               # host port -> postgres 5432 (e.g. 5433 staging)
TESSERA_AGENT_PORT=8099            # host port -> agent 8080  (e.g. 8100 staging)
TESSERA_FRONTEND_PORT=3090         # host port -> frontend 3000 (e.g. 3091 staging)
# OTLP collector the agent exports to — empty = export off (today's default).
# dev → the claude obs stack; prod-refinement sets its own. Telemetry stacks
# live in their own compose files and are never merged into this one.
TESSERA_OTEL_COLLECTOR_ENDPOINT=   # e.g. http://host.docker.internal:4418 (dev)

# ----------------------------------------------------------------------------
# HTTP layer
# ----------------------------------------------------------------------------
TESSERA_API__HOST=0.0.0.0
# Local dev ports (8099/3099) avoid clashes on frequent local runs. Deployment
# uses the code defaults (8080/3000) — do not propagate these to Cloud Run.
TESSERA_API__PORT=8099
# Service-to-service secret. Empty = auth OFF (local-open). When the app is
# web-exposed, set a strong value (openssl rand -hex 32); the Next front holds
# the SAME value in TESSERA_BACKEND_TOKEN (server-only) and injects it — the
# end user never authenticates. Anyone hitting the backend directly gets 401.
TESSERA_API__BEARER_TOKEN=
TESSERA_API__CORS_ORIGINS=["http://localhost:3099"]
# Anti-abuse (login-less public demo): per-session limit on /chat (keyed by the
# X-Session-Id cookie the front sets) + a hard global ceiling on total cost.
TESSERA_API__RATE_LIMIT_CHAT=20/hour
TESSERA_API__RATE_LIMIT_CHAT_GLOBAL=200/hour
# Trust X-Forwarded-For / CF-Connecting-IP for the rate-limit identity — only
# behind a trusted proxy (Next, nginx, cloudflared).
TESSERA_API__TRUST_FORWARDED_HEADERS=false

# --- Frontend (webapp/frontend/.env.local) ----------------------------------
# TESSERA_BACKEND_URL=http://localhost:8099
# TESSERA_BACKEND_TOKEN=  # server-only; MUST equal TESSERA_API__BEARER_TOKEN above

# ----------------------------------------------------------------------------
# Postgres + pgvector
# ----------------------------------------------------------------------------
TESSERA_POSTGRES__DSN=postgresql://tessera:tessera@localhost:5432/tessera
TESSERA_POSTGRES__POOL_MIN_SIZE=1
TESSERA_POSTGRES__POOL_MAX_SIZE=10
TESSERA_POSTGRES__VECTOR_TABLE=documents

# ----------------------------------------------------------------------------
# Vertex AI (frontier path)
# ----------------------------------------------------------------------------
TESSERA_VERTEX__PROJECT_ID=        # required to activate the frontier path
TESSERA_VERTEX__LOCATION=europe-west1
TESSERA_VERTEX__CHAT_MODEL=gemini-2.0-flash-001
TESSERA_VERTEX__EMBEDDING_MODEL=text-multilingual-embedding-002
TESSERA_VERTEX__EMBEDDING_DIMENSION=768

# ----------------------------------------------------------------------------
# Ollama (on-prem path)
# ----------------------------------------------------------------------------
TESSERA_OLLAMA__HOST=http://localhost:11434
TESSERA_OLLAMA__CHAT_MODEL=llama3.3:70b
TESSERA_OLLAMA__EMBEDDING_MODEL=bge-m3
TESSERA_OLLAMA__EMBEDDING_DIMENSION=1024

# ----------------------------------------------------------------------------
# Guard
# ----------------------------------------------------------------------------
TESSERA_GUARD__POLICY_PATH=src/tessera/guard/policy.yaml
TESSERA_GUARD__AUDIT_SINK=stdout   # stdout | cloud_logging | postgres
TESSERA_GUARD__FAIL_CLOSED=true
TESSERA_GUARD__ESCALATION_CONFIDENCE_THRESHOLD=0.6

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
TESSERA_OBSERVABILITY__LOG_LEVEL=INFO
TESSERA_OBSERVABILITY__LOG_FORMAT=console    # json | console
TESSERA_OBSERVABILITY__OTEL_SERVICE_NAME=tessera-agent
# OTLP endpoint. Leave empty -> the agent uses the console exporter and nothing
# reaches Phoenix/Langfuse. For the local on-prem stack (docker-compose.obs.claude.yml),
# point it at the collector's OTLP/HTTP port (4418:4318); a bare endpoint is
# normalised to /v1/traces. `make obs-up` brings the collector + Phoenix up.
TESSERA_OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4418   # empty = console only (no traces fed)
TESSERA_OBSERVABILITY__METRICS_ENABLED=true
TESSERA_OBSERVABILITY__METRICS_PORT=9090
TESSERA_OBSERVABILITY__CLOUD_LOGGING_PROJECT=

# ----------------------------------------------------------------------------
# Demo / audit
# ----------------------------------------------------------------------------
TESSERA_AUDIT_FILE=/tmp/tessera-audit.log
