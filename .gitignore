.env.dev
.env.staging
.env.production

# Ledger backups (audit P1.2) — the audit-chain DATA; never committed.
/backups/

# Node
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

