# Eval reports (generated)
eval/reports/*.json
eval/reports/*.html

# Calibration backfill cache (generated by scripts/backfill_calibration.py)
eval/calibration/_calibration.json

# Scratch / local working dir
tmp/

# Agent instruction files: AGENTS.md / CLAUDE.md are committed; machine-specific
# bits live in AGENTS.local.md (kept on disk, never published).
AGENTS.local.md
init_claude.sh

# Local-only eval-case generators (artefacts are the JSON files; method in docs/eval-sourcing.md)
scripts/_gen_*.py

# The eval null-control scratch dir (a control, never a published result — see Makefile)
.eval-control/

# Gate witness + worktree ownership (process P0, 2026-07-12). Both describe THIS
# checkout and must never travel to another one: a committed fingerprint would be a
# claim about a tree the reader is not standing in, and a committed owner marker would
# claim every clone at once.
.gate/
.worktree-owner
