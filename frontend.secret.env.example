# Front CONTAINER secrets for the `frontend` service (docker-compose.yml + fulllocal overlay).
#
# Copy to frontend.secret.env (gitignored by *.env) and fill in. These are the SAME three
# values the front needs anywhere; the container reads them at RUNTIME (the image bakes only
# a throwaway AUTH_SECRET placeholder), so the same image serves localhost and your domain.
#
#   cp frontend.secret.env.example frontend.secret.env
#   # fill in, then: make fulllocal-up
#
# Every value here has a MATCH on the agent — if they differ, operator pages 401. Generate
# fresh secrets and set the agent's side (root .env.local / infra/docker/cutover.env) to match.

# Service bearer for the server-side BFF→agent calls. MUST equal the agent's
# TESSERA_API__BEARER_TOKEN. (openssl rand -hex 32)
TESSERA_BACKEND_TOKEN=change-me

# Signs the operator session JWT (Auth.js / ADR 0009). Required for a domain-exposed front.
# (openssl rand -base64 33)
AUTH_SECRET=change-me

# Operator-assertion HMAC key (ADR 0010 Phase B/C). The BFF mints the assertion the agent
# verifies to grant AuthState.OPERATOR. MUST equal the agent's key, which the agent stores
# under the NESTED name TESSERA_API__OPERATOR_ASSERTION_SIGNING_KEY (double underscore); here
# it is a single underscore (Next reads process.env verbatim). (openssl rand -hex 32)
TESSERA_API_OPERATOR_ASSERTION_SIGNING_KEY=change-me

# --- Operator passwords (STRONGLY RECOMMENDED before exposing on your domain) --------------
# Without these the front falls back to the demo defaults shown in the login UI — fine on
# localhost, unsafe on a public domain. The superadmin password is yours to set and keep.
# TESSERA_AUTH_SUPERADMIN_PASSWORD=
# TESSERA_AUTH_ADMIN_PASSWORD=
# TESSERA_AUTH_AUDITOR_PASSWORD=
# TESSERA_AUTH_COLLECTIONS_PASSWORD=
