# Tessera agent — multi-stage build optimised for Cloud Run cold-start.
# Stage 1 installs dependencies via uv; stage 2 produces a slim runtime image.

# ---- Stage 1: builder ------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy

# Install uv from its official base image — small and pinned.
COPY --from=ghcr.io/astral-sh/uv:0.5.4 /uv /usr/local/bin/uv

WORKDIR /app

# System deps required to compile psycopg + the cryptography wheels, plus git:
# limes is a git dependency (pinned sha, public repo — no auth needed) and uv
# shells out to git to fetch it. Builder-only; the runtime stage ships no git.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# Resolve dependencies in their own layer for caching.
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-install-project --no-dev

# Then copy the source and install the project itself. `eval/` is a first-party
# package the wheel ships (pyproject: packages = ["src/tessera", "eval"]) — the
# agent imports eval.* at runtime (src/tessera/observability/eval_floor.py and
# five siblings). Without it here, hatchling silently builds a wheel missing eval
# and the container dies at startup with ModuleNotFoundError: No module named 'eval'.
COPY src ./src
COPY eval ./eval
COPY README.md LICENSE ./
# The trilingual message catalogues, authored under webapp/ and READ BY THE BACKEND.
# `/observability/localization` resolved them at `<repo>/webapp/frontend/messages`, which does
# not exist here — `ls /app` returns exactly `eval` and `src`. All three reads failed, the
# handler swallowed the errors into `{}`, and the endpoint reported **100 % complete** on a
# compliance surface for its entire life. Inside `src/` they are symlinks into webapp/ so the
# repo keeps ONE copy; this COPY replaces them with the real files, which is the only reason
# the container can answer at all.
COPY webapp/frontend/messages ./src/tessera/observability/data/messages
RUN uv sync --frozen --no-dev

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    TESSERA_API__HOST=0.0.0.0 \
    TESSERA_API__PORT=8080

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system tessera \
    && useradd --system --gid tessera --home /home/tessera tessera

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/src /app/src
# The project is installed editable: the venv's .pth adds /app and /app/src to
# sys.path rather than copying code into site-packages. `import tessera` resolves
# to /app/src/tessera; `import eval` (observability/eval_floor.py + 5 siblings)
# resolves to /app/eval — which must therefore exist in the runtime stage too.
COPY --from=builder /app/eval /app/eval

# Hardening (ADR 0008): remove pip entirely (binaries + package + dist-info, in
# both the venv and the base image's system site-packages) so a compromised
# process cannot install packages at runtime and image scanners do not flag the
# unused, vulnerable pip. Then own everything as root and make the venv and
# source read-only to the unprivileged runtime user.
RUN rm -rf /opt/venv/bin/pip* /usr/local/bin/pip* \
        /opt/venv/lib/python*/site-packages/pip \
        /opt/venv/lib/python*/site-packages/pip-*.dist-info \
        /usr/local/lib/python*/site-packages/pip \
        /usr/local/lib/python*/site-packages/pip-*.dist-info \
    && chown -R root:root /opt/venv /app \
    && chmod -R a-w /opt/venv /app

# Writable state dir for the file audit sink and the budget tracker. Created
# owned by the runtime user so a mounted volume inherits write access (a named
# volume copies the image dir's ownership). Locally this is volume-backed so the
# audit trail and token counters survive container recreation; on Cloud Run the
# audit sink is cloud_logging, so this is just a scratch dir there.
RUN mkdir -p /tmp/tessera && chown tessera:tessera /tmp/tessera

# The commit this image was built from, so the process can answer "is this the code I think it
# is?" without a git tree — `tessera.code_identity` reads exactly this variable and reports
# `code_sha_source: "env"`. Its default is EMPTY, not "dev": an empty value falls through to the
# git probe and then to an honest `code_sha: null`, whereas a placeholder that looks like a
# stamp would be a fabricated answer to the one question this endpoint exists for.
ARG TESSERA_BUILD_SHA=
ENV TESSERA_BUILD_SHA=$TESSERA_BUILD_SHA

USER tessera:tessera
EXPOSE 8080

# Probe /readyz, not /healthz: readiness verifies the LLM backend is reachable,
# so the container reports unhealthy when it could only serve silent escalations
# (a 503 makes urlopen raise → non-zero exit). start-period covers Ollama warmup.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/readyz').read()"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["tessera"]
