# Tessera dashboard — Next.js production build.

# ---- Stage 1: dependencies -------------------------------------------------
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY webapp/frontend/package.json webapp/frontend/pnpm-lock.yaml* webapp/frontend/package-lock.json* webapp/frontend/yarn.lock* ./
RUN \
    if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then yarn --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    else npm install; fi

# ---- Stage 2: build --------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY webapp/frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
# Build-only placeholder so `next build` never trips on a missing Auth.js secret
# during data collection. The real AUTH_SECRET is injected at runtime by Cloud
# Run (Secret Manager) and is NOT inherited by the runtime stage below.
ENV AUTH_SECRET="build-time-placeholder-not-used-at-runtime"
RUN \
    if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm build; \
    elif [ -f yarn.lock ]; then yarn build; \
    else npm run build; fi

# ---- Stage 3: runtime ------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    # Next.js standalone server.js binds to process.env.HOSTNAME. Docker sets
    # HOSTNAME to the container id, so without this the server listens only on
    # the container's own hostname/IP — localhost:3000 (the healthcheck) and
    # Cloud Run's 0.0.0.0:$PORT routing both fail. Pin it to all interfaces.
    HOSTNAME=0.0.0.0

# Build provenance baked into the image (ADR 0048). /api/version serves these so
# `make deploy-diff` can confirm both deployment targets run the same commit. The
# defaults keep an un-stamped local build honest — it reports sha=dev, which the
# witness treats as a divergence against a real SHA rather than a false match.
ARG TESSERA_BUILD_SHA=dev
ARG TESSERA_BUILD_TIME=unknown
ARG TESSERA_TARGET=unknown
ENV TESSERA_BUILD_SHA=$TESSERA_BUILD_SHA \
    TESSERA_BUILD_TIME=$TESSERA_BUILD_TIME \
    TESSERA_TARGET=$TESSERA_TARGET

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Curated eval scorecards: the standalone server reads these at runtime via
# lib/eval.ts when no repo root is present (the deployed image has none), so the
# dashboard renders real scores instead of an empty state. Non-sensitive data.
COPY --from=builder --chown=nextjs:nodejs /app/data ./data

USER nextjs
EXPOSE 3000

# Use 127.0.0.1, not localhost: Alpine maps localhost to ::1 as well, busybox
# wget tries IPv6 first, and the server listens on 0.0.0.0 (IPv4) only.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
