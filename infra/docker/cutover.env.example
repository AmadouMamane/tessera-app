# Cutover secrets + machine overrides for docker-compose.cutover.yml.
#
# Copy to infra/docker/cutover.env (gitignored) and fill in the real values.
# ONLY secrets and machine-specific overrides belong here — all non-secret wiring
# is declared inline in docker-compose.cutover.yml so it stays reviewable.
#
#   cp infra/docker/cutover.env.example infra/docker/cutover.env
#   # edit infra/docker/cutover.env with the real values, then:
#   docker compose -f docker-compose.yml -f docker-compose.unix.yml \
#       -f docker-compose.cutover.yml up -d --no-deps --force-recreate agent
#   make preflight        # assert every input before trusting the container

# --- Secrets (REQUIRED) ------------------------------------------------------
# ClickHouse HTTP password for the self-hosted obs stack.
TESSERA_CLICKHOUSE_PASSWORD=change-me
# Operator-assertion HMAC key. MUST be byte-identical to the front's
# TESSERA_API_OPERATOR_ASSERTION_SIGNING_KEY, or every operator page 401s.
TESSERA_API__OPERATOR_ASSERTION_SIGNING_KEY=change-me

# --- Machine overrides (OPTIONAL — sensible defaults live in the compose) -----
# Durable agent state OUTSIDE the repo (audit sink + budget), survives reboot.
# TESSERA_AGENT_STATE=/Users/you/.tessera/agent-state
# External Docker network names, if your live stacks differ from the defaults.
# TESSERA_DATA_NETWORK=tessera_default
# TESSERA_OBS_NETWORK=tessera-claude-obs
# Published ports (host side).
# TESSERA_AGENT_PORT=8099
# TESSERA_METRICS_PORT=9090
