# Full-local tunnel config for docker-compose.fulllocal.yml (ADR 0045).
#
# Copy to infra/docker/fulllocal.env (gitignored) and fill in the token.
# Only the tunnel connector token belongs here; everything else is inline in the overlay.
#
#   cp infra/docker/fulllocal.env.example infra/docker/fulllocal.env
#   # paste the token from the Cloudflare dashboard, then (only when ready to flip):
#   make fulllocal-tunnel

# --- Cloudflare Tunnel connector token (REQUIRED for the flip) ----------------
# Cloudflare Zero Trust dashboard → Networks → Tunnels → create a tunnel → copy the
# connector token. In that same tunnel, add a Public Hostname:
#     <your domain, e.g. cockpit.example.com>  →  Service: http://frontend:3000
# The cloudflared image reads this variable name verbatim.
TUNNEL_TOKEN=change-me

# --- ngrok alternative (if you keep OVH DNS and prefer a CNAME) ---------------
# Not used by this compose; documented for the runbook. With a paid ngrok custom
# domain you add ONE CNAME at OVH and run, instead of cloudflared:
#     ngrok http --domain=<your domain> 3090
