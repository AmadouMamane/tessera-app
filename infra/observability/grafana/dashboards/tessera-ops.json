{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Tessera — Agent Ops (SLO)",
  "uid": "tessera-ops",
  "tags": ["tessera", "agent", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Turns (total)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(tessera_agent_turns_total)", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated LLM cost (EUR, this process)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 4, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(tessera_llm_estimated_cost_eur)", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Turn rate (1/s, 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 3, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tessera_agent_turns_total[5m]))", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Escalation share (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tessera_agent_turns_total{outcome=\"escalated\"}[5m])) / clamp_min(sum(rate(tessera_agent_turns_total[5m])), 0.0001)", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Turn rate by outcome (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(tessera_agent_turns_total[5m]))", "legendFormat": "{{outcome}}", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Turn latency p50 / p95 / p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(tessera_agent_turn_duration_seconds_bucket[5m])))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tessera_agent_turn_duration_seconds_bucket[5m])))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(tessera_agent_turn_duration_seconds_bucket[5m])))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Guard decisions by verdict (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (decision) (rate(tessera_guard_decisions_total[5m]))", "legendFormat": "{{decision}}", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Online eval score p50 by metric (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "tessera-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, metric) (rate(tessera_eval_score_bucket[5m])))", "legendFormat": "{{metric}}", "datasource": { "type": "prometheus", "uid": "tessera-prometheus" } }
      ]
    }
  ]
}
