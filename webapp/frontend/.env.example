# Frontend environment — copy to .env.local (gitignored) and fill in.

# Backend agent the server-side proxy talks to, and the service bearer token
# (must match the agent's TESSERA_API__BEARER_TOKEN). Server-only, never NEXT_PUBLIC_.
TESSERA_BACKEND_URL=http://localhost:8099
TESSERA_BACKEND_TOKEN=change-me

# Auth.js (ADR 0009). AUTH_SECRET signs the session JWT — required in production.
# Generate with: openssl rand -base64 33
AUTH_SECRET=change-me

# Demo operator passwords. Optional — fall back to the demo defaults
# (tessera-admin / tessera-auditor) which are displayed in the login UI.
# TESSERA_AUTH_ADMIN_PASSWORD=
# TESSERA_AUTH_AUDITOR_PASSWORD=

# Operator assertion signing key (ADR 0010 Phase B/C). The BFF mints a signed
# operator assertion the agent verifies to derive AuthState.OPERATOR. The VALUE
# MUST equal the agent's key (root .env.local), which it stores under the nested
# name TESSERA_API__OPERATOR_ASSERTION_SIGNING_KEY (double underscore). Here it is
# a single underscore — Next reads process.env verbatim. If unset or differing,
# the operator path is inert and recouvrement console turns silently fall back to
# the customer widget (support-client). openssl rand -hex 32.
TESSERA_API_OPERATOR_ASSERTION_SIGNING_KEY=change-me
